<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="anonymous-all">

    <transition name="createProductAssociation">
        <service-call name="create#assignment.ProductAssoc"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteProductAssoc">
        <service-call name="delete#assignment.ProductAssoc"/>
        <default-response url="."/>
    </transition>

    <transition name="editProductAssoc">
        <service-call name="update#assignment.ProductAssoc"/>
        <default-response url="."/>
    </transition>



    <actions>
        <entity-find entity-name="assignment.ProductAssoc" list="productAssocList"/>

    </actions>



    <widgets>

        <container-box><box-header><label text="Find Product Association" type="h5"/></box-header><box-toolbar>
            <container-dialog id="CreateAssociationDialog" button-text="Create Product Association">
                <form-single name="CreateProductAssociation" transition="createProductAssociation">
                    <auto-fields-entity entity-name="assignment.ProductAssoc" field-type="edit"/>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            <container-dialog id="EditProductAssoc" button-text="Edit Product Assoc">
                <form-single name="EditProductAssoc" transition="editProductAssoc">
                    <auto-fields-entity entity-name="assignment.ProductAssoc" field-type="edit"/>
                    <field name="submitButton">
                        <default-field title="Save Changes">
                            <submit/>
                        </default-field>
                    </field>
                </form-single>
            </container-dialog>
        </box-toolbar>
            <box-body>
                <form-list name="ProductAssociationList" list="productAssocList" header-dialog="true"  >
                    <auto-fields-entity entity-name="ProductAssoc" field-type="find-display"/>
                    <field name="findButton"><header-field >
                        <submit text="Find"/></header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="productPriceAssoc">
                        <default-field>
                            <link text="Delete" url="deleteProductAssoc">
                                <parameter name="productId"/>
                            </link>
                        </default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>




    </widgets>
</screen>