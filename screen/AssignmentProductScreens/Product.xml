<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="anonymous-all">

    <transition name="createProduct">
        <service-call name="create#assignment.Product"/>
        <default-response url="."/>
    </transition>
    <transition name="deleteProduct">
        <service-call name="delete#assignment.Product"/>
        <default-response url="."/>
    </transition>
    <transition name="editProduct">
        <service-call name="update#assignment.Product"/>
        <default-response url="."/>
    </transition>


    
    <actions>
        <entity-find entity-name="assignment.Product" list="productList">
            <search-form-inputs default-order-by="^productName"/></entity-find>

    </actions>

    <widgets>

        <container-box><box-header><label text="Find Product" type="h5"/></box-header><box-toolbar>
            <container-dialog id="CreateProductDialog" button-text="Create Product">

                <form-single name="CreateProduct" transition="createProduct">
                    <auto-fields-entity entity-name="assignment.Product" field-type="edit"/>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
            </container-dialog>
            <container-dialog id="EditProductDialog" button-text="Edit Product">
                <form-single name="EditProduct" transition="editProduct">
                    <auto-fields-entity entity-name="assignment.Product" field-type="edit"/>
                    <field name="submitButton">
                        <default-field title="Save Changes">
                            <submit/>
                        </default-field>
                    </field>
                </form-single>
            </container-dialog>
        </box-toolbar>
            <box-body>
                <form-list name="Product" list="productList" header-dialog="true"  >
                    <auto-fields-entity entity-name="assignment.Product" field-type="find-display"/>
                    <field name="findButton"><header-field >
                        <submit text="Find"/></header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="product">
                        <default-field>
                            <link text="Delete" url="deleteProduct">
                                <parameter name="productId"/>
                            </link>
                        </default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>

    </widgets>
</screen>