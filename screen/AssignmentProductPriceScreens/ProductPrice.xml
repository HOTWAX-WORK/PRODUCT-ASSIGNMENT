<?xml version="1.0" encoding="UTF-8"?>
<screen xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
        xsi:noNamespaceSchemaLocation="http://moqui.org/xsd/xml-screen-3.xsd"
        require-authentication="anonymous-all">

    <transition name="createPrice">
        <service-call name="create#assignment.ProductPrice"/>
        <default-response url="."/>
    </transition>

    <transition name="deleteProductPrice">
        <service-call name="delete#assignment.ProductPrice"/>
        <default-response url="."/>
    </transition>

    <transition name="editProductPrice">
        <service-call name="update#assignment.ProductPrice"/>
        <default-response url="."/>
    </transition>


    <actions>

        <entity-find entity-name="assignment.ProductPrice" list="productPriceList">
            <search-form-inputs default-order-by="^fromDate"/></entity-find>

    </actions>

    <widgets>

        <container-box><box-header><label text="Find Product Price" type="h5"/></box-header><box-toolbar>
            <container-dialog id="CreatePriceDialog" button-text="Create Product Price">
                <form-single name="CreateProductPrice" transition="createProductPrice">
                    <auto-fields-entity entity-name="assignment.ProductPrice" field-type="edit"/>
                    <field name="submitButton"><default-field title="Create"><submit/></default-field></field>
                </form-single>
<!--                <container-dialog id="EditProductPriceDialog" button-text="Edit Price">-->
<!--                    <form-single name="EditProductPrice" transition="editProductPrice">-->
<!--                        <auto-fields-entity entity-name="assignment.ProductPrice" field-type="edit"/>-->
<!--                        <field name="submitButton">-->
<!--                            <default-field title="Save Changes">-->
<!--                                <submit/>-->
<!--                            </default-field>-->
<!--                        </field>-->
<!--                    </form-single>-->
<!--                </container-dialog>-->
            </container-dialog>
        </box-toolbar>
            <box-body>
                <form-list name="ProductPriceList" list="productPriceList" header-dialog="true"  >
                    <auto-fields-entity entity-name="ProductPrice" field-type="find-display"/>
                    <field name="findButton"><header-field >
                        <submit text="Find"/></header-field>
                        <default-field><ignored/></default-field>
                    </field>
                    <field name="productPriceDelete">
                        <default-field>
                            <link text="Delete" url="deleteProductPrice">
                                <parameter name="productPriceId"/>
                            </link>
                        </default-field>
                    </field>
                </form-list>
            </box-body>
        </container-box>


    </widgets>
</screen>